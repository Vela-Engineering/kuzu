-DATASET CSV tinysnb
--

-CASE ConcurrentScan
-CREATE_CONNECTION conn2
-CREATE_CONNECTION conn3
-CREATE_CONNECTION conn4
-STATEMENT CREATE NODE TABLE t(a INT, b INT, PRIMARY KEY(a));
---- ok
-BEGIN_CONCURRENT_EXECUTION
-STATEMENT MATCH (:person) return count(*);
---- 1
8
-STATEMENT [conn2] MATCH (:person) return count(*);
---- 1
8
-STATEMENT [conn3] MATCH (:person) return count(*);
---- 1
8
-STATEMENT [conn4] MATCH (:person) return count(*);
---- 1
8
-END_CONCURRENT_EXECUTION

-CASE ConcurrentSingleWriteAlter
-CREATE_CONNECTION conn2
-BEGIN_CONCURRENT_EXECUTION
-STATEMENT ALTER TABLE person ADD propA INT64;
---- ok
-STATEMENT [conn2] MATCH (:person) return count(*);
---- ok
-END_CONCURRENT_EXECUTION
-STATEMENT CALL table_info('person') return *;
---- 17
0|ID|INT64|NULL|True
1|fName|STRING|NULL|False
2|gender|INT64|NULL|False
3|isStudent|BOOL|NULL|False
4|isWorker|BOOL|NULL|False
5|age|INT64|NULL|False
6|eyeSight|DOUBLE|NULL|False
7|birthdate|DATE|NULL|False
8|registerTime|TIMESTAMP|NULL|False
9|lastJobDuration|INTERVAL|NULL|False
10|workedHours|INT64[]|NULL|False
11|usedNames|STRING[]|NULL|False
12|courseScoresPerTerm|INT64[][]|NULL|False
13|grades|INT64[4]|NULL|False
14|height|FLOAT|NULL|False
15|u|UUID|NULL|False
16|propA|INT64|NULL|False

-CASE ConcurrentMultiWriteCreateTable
-STATEMENT CALL experimental_concurrent_writes=true;
---- ok
-CREATE_CONNECTION conn2
-CREATE_CONNECTION conn3
-CREATE_CONNECTION conn4
-BEGIN_CONCURRENT_EXECUTION
-STATEMENT CREATE NODE TABLE a(id INT, PRIMARY KEY(id));
---- ok
-STATEMENT [conn2] CREATE NODE TABLE b(id INT, PRIMARY KEY(id));
---- ok
-STATEMENT [conn3] CREATE NODE TABLE c(id INT, PRIMARY KEY(id));
---- ok
-STATEMENT [conn4] CREATE NODE TABLE d(id INT, PRIMARY KEY(id));
---- ok
-END_CONCURRENT_EXECUTION

-CASE ConcurrentMultiWriteAlter
-STATEMENT CALL experimental_concurrent_writes=true;
---- ok
-CREATE_CONNECTION conn2
-CREATE_CONNECTION conn3
-CREATE_CONNECTION conn4
-BEGIN_CONCURRENT_EXECUTION
-STATEMENT ALTER TABLE person ADD propA INT64;
---- ok
-STATEMENT [conn2] ALTER TABLE organisation ADD propB STRING;
---- ok
-STATEMENT [conn3] ALTER TABLE movies ADD propC BOOL;
---- ok
-STATEMENT [conn4] ALTER TABLE knows ADD propD DATE;
---- ok
-END_CONCURRENT_EXECUTION
-STATEMENT CALL table_info('person') WHERE name='propA' RETURN name, type;
---- 1
propA|INT64
-STATEMENT CALL table_info('organisation') WHERE name='propB' RETURN name, type;
---- 1
propB|STRING
-STATEMENT CALL table_info('movies') WHERE name='propC' RETURN name, type;
---- 1
propC|BOOL
-STATEMENT CALL table_info('knows') WHERE name='propD' RETURN name, type;
---- 1
propD|DATE
